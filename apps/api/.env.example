# Only needed when running the API outside Docker (docker compose sets these itself)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobtracker
PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
AI_BATCH_SIZE=5
AI_BATCH_DELAY_MS=200
TRENDS_CACHE_TTL_HOURS=6
SCRAPER_URL=http://localhost:8000
