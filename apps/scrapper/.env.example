# Base URL of the NestJS API (no /api suffix)
NESTJS_URL=http://localhost:3000

# Defaults for the scheduled cron job only.
# Manual POST /scrape and GET /scrape/preview accept params in the request body/query.
SEARCH_TERMS=software engineer,frontend developer,backend developer
LOCATIONS=mexico,worldwide
RESULTS=30
HOURS_OLD=48
SCRAPE_INTERVAL_HOURS=6
PORT=8000
