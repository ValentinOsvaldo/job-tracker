# Base URL of the NestJS API (no /api suffix)
NESTJS_URL=http://localhost:3000

# Defaults used when POST /scrape or GET /scrape/preview are called without params.
SEARCH_TERMS=software engineer,frontend developer,backend developer
LOCATIONS=mexico
RESULTS=15
HOURS_OLD=48
PORT=8000

# Fetch full LinkedIn descriptions (slower) to improve salary/description capture
LINKEDIN_FETCH_DESCRIPTION=true
# Normalize wages to annual where Jobspy can
ENFORCE_ANNUAL_SALARY=true
# Drop non-software / commercial noise after scrape
RELEVANCE_FILTER=true
