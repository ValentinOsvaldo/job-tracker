# Required by nuxt-auth-utils (min 32 chars)
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string

# NestJS API origin (server-only; Nitro BFF proxies to this)
NUXT_API_BASE_URL=http://localhost:3000

# Must match Nest SEED_SECRET (server-only; used by Settings → Run seed)
NUXT_SEED_SECRET=change_me
