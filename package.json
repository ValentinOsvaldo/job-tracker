{
  "name": "job-tracker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:api": "pnpm --filter @job-tracker/api start:dev",
    "start:web": "pnpm --filter @job-tracker/web dev",
    "start:scrapper": "cd apps/scrapper && .venv\\Scripts\\python -m uvicorn main:app --reload --port 8000",
    "start:all": "concurrently -n api,web,scrapper \"pnpm run start:api\" \"pnpm run start:web\" \"pnpm run start:scrapper\"",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "lint-staged": {
    "apps/web/**/*.{ts,vue,js,mjs}": "pnpm --filter @job-tracker/web exec eslint --fix",
    "apps/api/**/*.ts": "pnpm --filter @job-tracker/api exec eslint --fix"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  }
}
